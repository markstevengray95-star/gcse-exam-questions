# Server-side Gemini credential for AI marking and question generation.
# Keep this secret out of browser code and Git history.
# New Google AI Studio authorization keys (including AQ.-prefixed keys) should be stored here.
GEMINI_API_KEY=your_api_key_here

# GOOGLE_API_KEY is also supported as a fallback variable name.
# GOOGLE_API_KEY=your_api_key_here
